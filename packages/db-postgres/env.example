# Pooled endpoint (note the "-pooler" in the host). Every service and every
# serverless function opens its own Prisma pool, so without PgBouncer in front
# a handful of instances is enough connections to push Neon's autoscaler onto a
# larger, more expensive compute tier. Use the direct (non-pooler) host only for
# `prisma migrate`, which needs a session-mode connection.
POSTGRES_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
# Per-process Prisma pool ceiling. Prisma otherwise defaults to (cores * 2 + 1)
# connections per service, which is far more than these services need and more
# than the compute should be sized for.
PRISMA_POOL_MAX=3
PRISMA_POOL_TIMEOUT=20
