generator client {
  provider      = "prisma-client-js"
  output        = "./generated-client"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-arm64-openssl-1.1.x", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  ASSIGNED_TO_RIDER
  REJECTED
  SHIPPED
  DELIVERED
  CANCELLED
}

// The order's own view of rider progress, distinct from the rider's own
// status on the Mongo `riders` collection (which flips back to AVAILABLE
// once released) — this one is a one-way record of what happened on THIS
// order and is never reset.
enum OrderRiderStatus {
  ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  // Refund submitted to the gateway but not yet settled. Gateway refunds are
  // asynchronous and can still fail, so REFUNDED is only set once the
  // refund.processed webhook confirms it.
  REFUND_PENDING
  REFUNDED
}

enum CancelledBy {
  CUSTOMER
  SELLER
  STAFF
  SYSTEM
}

// Separate from PaymentStatus's REFUND_PENDING/REFUNDED — that field tracks
// what was actually collected (a payment concept); this one tracks a refund
// attempt end-to-end from the moment it's requested, including a state
// (PROCESSING) that begins before the gateway is even called.
enum RefundStatus {
  NONE
  REQUESTED
  PROCESSING
  COMPLETED
  FAILED
}

enum PaymentMethod {
  COD
  RAZORPAY
  // Legacy value still accepted by the createOrder zod schema. Kept so the
  // enum cast doesn't drop existing rows, but note it is not handled
  // consistently downstream: the stale-order job treats it as online
  // (`paymentMethod != COD`) while the refund path only accepts RAZORPAY, so
  // an ONLINE order cannot currently be refunded. Reconciling that is a
  // behaviour change, not a schema one.
  ONLINE
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum StockReservationStatus {
  HELD
  CONSUMED
  RELEASED
}

enum AuditEntityType {
  ORDER
  PAYMENT
  COUPON
  STOCK
  REFUND
  REFERRAL
}

enum ActorType {
  USER
  SELLER
  ADMIN
  SYSTEM
}

model Order {
  id      String @id @default(cuid())
  userId  String // Reference to Mongo User ID
  storeId String // Reference to Mongo Store ID

  // Money is Decimal, never Float: binary floating point cannot represent
  // values like 20.35 exactly, so float totals drift against Razorpay (which
  // settles in integer paise) and `sum(items) + delivery - discount` stops
  // equalling totalAmount. Reads cross the API boundary via `toMoney`.
  totalAmount    Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  couponCode     String?
  // Deliberately not an enum: the lowercase value is compared against string
  // literals throughout user-ui and mobile, so uppercasing it would break the
  // response contract.
  deliverySlot   String? // "instant" | "morning" | "evening"

  // Delivery details
  deliveryName    String?
  deliveryPhone   String?
  deliveryAddress String?
  deliveryCity    String?
  deliveryPincode String?
  deliveryCharge  Decimal @default(0) @db.Decimal(12, 2)
  billDetails     Json? // Snapshot of { itemTotal, deliveryCharge, slotExtraCharge, packagingCharge, gstAmount, discount, totalAmount, eventId? }

  status        OrderStatus    @default(PENDING)
  paymentStatus PaymentStatus  @default(PENDING)
  paymentMethod PaymentMethod?
  paymentRef    String?

  // Rider assignment — riderId is a bare reference to the Mongo `riders`
  // collection, same cross-DB convention as storeId/userId above.
  riderId         String?
  riderStatus     OrderRiderStatus?
  assignedAt      DateTime?
  assignedBy      String? // sellerId or staffId (Mongo ObjectId) who assigned the rider
  pickupStartedAt DateTime? // set when status flips to SHIPPED (rider left the store)
  deliveredAt     DateTime? // set when status flips to DELIVERED

  rejectionReason    String?
  // Who/why/when an order was cancelled — set on any path that flips status
  // to CANCELLED (customer self-cancel, seller/staff cancel, or the system).
  // cancellationReason is free text from staff but one of a fixed quick-pick
  // list from a customer (see cancelOrderSchema).
  cancellationReason String?
  cancelledBy        CancelledBy?
  cancelledAt        DateTime?
  // NONE until a refund is actually requested — most cancelled orders (COD,
  // or paid orders cancelled while still unpaid) never touch this.
  refundStatus       RefundStatus @default(NONE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems   OrderItem[]
  payments     Payment[]
  couponUsages CouponUsage[]

  // Postgres serves a query from any leftmost prefix of a compound index, so
  // standalone [userId] / [storeId] indexes would be dead weight on every
  // write. A standalone [status] was dropped too — six enum values over the
  // whole table is not selective enough for the planner to prefer it; the one
  // query that does filter on status (the stale-order sweeper) is served by a
  // partial index created in migration 20260807000001.
  @@index([userId, createdAt(sort: Desc)]) // user order history with recent-first sort
  @@index([storeId, createdAt(sort: Desc)]) // seller order dashboard + stats range scans
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String // Reference to Mongo Product ID
  quantity        Int
  price           Decimal @db.Decimal(12, 2)
  selectedOptions Json?

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id      String        @id @default(cuid())
  orderId String
  order   Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount  Decimal       @db.Decimal(12, 2)
  status  PaymentStatus @default(PENDING)
  method  PaymentMethod

  // The gateway's own payment id (Razorpay payment_id), set on capture.
  transactionId  String? @unique
  // The gateway's order id (Razorpay order_id), bound at checkout creation.
  // Indexed because reconciliation looks payments up by it — it previously
  // lived in `metadata` and could only be found by an unindexed JSON scan.
  gatewayOrderId String? @unique

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status, createdAt]) // reconciliation sweep over stale PENDING rows
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String // Reference to Mongo Coupon ID
  userId    String // Reference to Mongo User ID
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([couponId, userId])
  @@index([orderId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String // Reference to Mongo User ID
  title     String
  message   String
  type      String   @default("INFO") // "INFO", "SUCCESS", "WARNING", "ERROR"
  category  String? // "ORDER", "SYSTEM", "PROMO", etc.
  isRead    Boolean  @default(false)
  metadata  Json? // For deep linking, e.g., { orderId: "..." }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The unread badge queries { userId, isRead: false }. It is served by a
  // partial index on (userId, createdAt) WHERE is_read = false, created in
  // migration 20260807000001 — partial because almost every row ends up read,
  // so the index stays small no matter how much history accumulates.
  @@index([userId, createdAt])
}

// Immutable financial audit trail — never delete rows from this table
model AuditLog {
  id         String          @id @default(cuid())
  entityType AuditEntityType
  entityId   String // orderId, paymentId, etc.
  // Deliberately a String rather than an enum: the action vocabulary grows
  // every time an event is added, and an enum would mean a schema migration
  // for each one. Typo-safety comes from the AuditAction union in audit.ts,
  // which is checked at the call site instead.
  action     String
  actorId    String? // userId, sellerId, adminId — null means system
  actorType  ActorType?
  metadata   Json? // snapshot of relevant data at the time of the event
  createdAt  DateTime        @default(now())

  // entityId is an id and therefore selective on its own; a compound
  // [entityType, entityId] would narrow almost nothing on top of it. actorId
  // had an index but is only ever written, never filtered on.
  @@index([entityId])
  @@index([action, createdAt(sort: Desc)]) // listPaymentsNeedingAttention
  @@index([createdAt])
}

// Durable record of gateway webhooks. Dedupe used to live only in Redis on a
// TTL, which is a cache, not an audit trail — a replay after eviction would
// re-apply, and there was no record of what the gateway actually sent.
model WebhookEvent {
  id        String @id @default(cuid())
  provider  String // "RAZORPAY"
  eventId   String // the gateway's own event id (x-razorpay-event-id)
  eventType String
  payload   Json

  receivedAt  DateTime  @default(now())
  // Null means received but not yet applied — either in flight or it failed
  // and the gateway's retry will pick it up. Dedupe keys off this, not mere
  // row existence, so a failed attempt doesn't block the retry.
  processedAt DateTime?

  // The unprocessed set is tiny and the processed set grows without bound, so
  // the sweeper is served by a partial index on (received_at) WHERE
  // processed_at IS NULL (migration 20260807000001) rather than a full index
  // over every webhook ever received.
  @@unique([provider, eventId])
  @@index([receivedAt])
}

// Transactional outbox. Written inside the same Postgres transaction as the
// state change it describes, so "committed" and "will be published" are
// atomic. Publishing straight to RabbitMQ after a commit loses the message if
// the process dies in between.
model OutboxEvent {
  id          String       @id @default(cuid())
  aggregate   String // "ORDER" | "PAYMENT"
  aggregateId String
  eventType   String // "ORDER_CREATED" | "COUPON_APPLIED"
  queue       String // target RabbitMQ queue
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  lastError   String?
  createdAt   DateTime     @default(now())
  publishedAt DateTime?

  // Claimed by the relay so two instances can't publish the same row. Rows are
  // selected FOR UPDATE SKIP LOCKED and stamped; a claim older than the lease
  // window is treated as abandoned and retried.
  lockedAt DateTime?
  lockedBy String?

  // The relay only ever reads PENDING rows and the retention job only ever
  // reads settled ones, so both are served by partial indexes rather than one
  // full index over a table that grows forever (migration 20260807000001).
  @@index([aggregate, aggregateId])
}

// Durable record of a Mongo stock decrement. Stock is reserved in Mongo before
// the Postgres order transaction (so we never sell stock we didn't hold), which
// leaves a window where a crash loses the only record of the reservation. This
// row is written first and marked CONSUMED inside the order transaction; a
// sweeper releases anything left HELD.
model StockReservation {
  id        String                 @id @default(cuid())
  orderId   String? // set once the order transaction commits
  userId    String
  items     Json // [{ productId, quantity }]
  status    StockReservationStatus @default(HELD)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  // Like the outbox, the sweeper only reads HELD rows — partial index in
  // migration 20260807000001.
  @@index([orderId])
}
