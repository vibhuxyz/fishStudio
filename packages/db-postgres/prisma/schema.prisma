generator client {
  provider      = "prisma-client-js"
  output        = "./generated-client"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-arm64-openssl-1.1.x", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  ASSIGNED_TO_RIDER
  REJECTED
  SHIPPED
  DELIVERED
  CANCELLED
}

// The order's own view of rider progress, distinct from the rider's own
// status on the Mongo `riders` collection (which flips back to AVAILABLE
// once released) — this one is a one-way record of what happened on THIS
// order and is never reset.
enum OrderRiderStatus {
  ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  // No money was ever due or attempted: a COD order cancelled before the rider
  // collected, or an online checkout the customer abandoned. Distinct from
  // FAILED, which means the gateway declined a real attempt and is worth
  // investigating — collapsing the two would bury genuine failures. PENDING is
  // reserved for orders where money is still expected.
  NOT_PAID
  // Refund submitted to the gateway but not yet settled. Gateway refunds are
  // asynchronous and can still fail, so REFUNDED is only set once the
  // refund.processed webhook confirms it.
  REFUND_PENDING
  REFUNDED
}

enum CancelledBy {
  CUSTOMER
  SELLER
  STAFF
  SYSTEM
}

// Separate from PaymentStatus's REFUND_PENDING/REFUNDED — that field tracks
// what was actually collected (a payment concept); this one tracks a refund
// attempt end-to-end from the moment it's requested, including a state
// (PROCESSING) that begins before the gateway is even called.
enum RefundStatus {
  NONE
  REQUESTED
  PROCESSING
  COMPLETED
  FAILED
}

enum PaymentMethod {
  COD
  RAZORPAY
  // Legacy value still accepted by the createOrder zod schema. Kept so the
  // enum cast doesn't drop existing rows, but note it is not handled
  // consistently downstream: the stale-order job treats it as online
  // (`paymentMethod != COD`) while the refund path only accepts RAZORPAY, so
  // an ONLINE order cannot currently be refunded. Reconciling that is a
  // behaviour change, not a schema one.
  ONLINE
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum StockReservationStatus {
  HELD
  CONSUMED
  RELEASED
}

enum AuditEntityType {
  ORDER
  PAYMENT
  COUPON
  STOCK
  REFUND
  REFERRAL
  // Cash a rider collected and a manager signed off. Distinct from PAYMENT:
  // that is money moving through the gateway, this is money moving hand to
  // hand, and the two get reconciled against each other.
  COD
}

enum ActorType {
  USER
  SELLER
  ADMIN
  SYSTEM
}

model Order {
  id          String  @id @default(cuid())
  // The human-facing identifier: FS-NOI-30082026-001 — FS, the store's
  // location code, the IST date, and a per-location counter that restarts
  // daily. `id` above stays the key every relation and URL uses; this exists
  // because "FS-NOI-30082026-001" is what a seller reads out over the phone
  // and what backend console search is done by.
  //
  // Nullable: every order placed before this column existed has none, and a
  // store whose locationCode has not been set yet must still be able to trade.
  // Uniqueness is a partial index (see migration 20260831090000) so those
  // NULLs cost nothing.
  orderNumber String?
  // The statutory GST invoice number, e.g. FS/NOI/2026-27/00042. Separate from
  // orderNumber because the two obey different rules: an order number is an
  // operational handle that may be issued for an order later cancelled, while
  // an invoice number must be consecutive within a financial year and is never
  // reused. Allocated once, the first time an invoice is actually issued —
  // which is why it is null on every order nobody has downloaded one for.
  invoiceNumber String?
  invoicedAt    DateTime? @db.Timestamptz(3)
  userId      String // Reference to Mongo User ID
  storeId     String // Reference to Mongo Store ID

  // Money is Decimal, never Float: binary floating point cannot represent
  // values like 20.35 exactly, so float totals drift against Razorpay (which
  // settles in integer paise) and `sum(items) + delivery - discount` stops
  // equalling totalAmount. Reads cross the API boundary via `toMoney`.
  totalAmount    Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  couponCode     String?
  // Deliberately not an enum: the lowercase value is compared against string
  // literals throughout user-ui and mobile, so uppercasing it would break the
  // response contract.
  deliverySlot   String? // "instant" | "morning" | "evening"
  // The calendar day the slot belongs to, ddMMyyyy in IST — same convention as
  // OrderNumberSequence.dateKey. Kept as the store's own day rather than a
  // timestamp because that is what capacity is counted against, and a UTC day
  // would roll over at 05:30 local. Null on orders placed before slots were
  // dated, and on "instant", which is always today by definition.
  deliveryDate   String?

  // Delivery details
  deliveryName         String?
  deliveryPhone        String?
  deliveryAddress      String?
  deliveryCity         String?
  deliveryPincode      String?
  // Free text carried straight from the customer's saved address so the
  // rider sees them on the order, not just at checkout time.
  deliveryLandmark     String?
  deliveryInstructions String?
  // The exact map pin the customer dropped on their saved address, carried
  // through to the order so the rider's map link goes to the precise spot
  // instead of a fuzzy text-address search. Null for orders placed against
  // an address saved before the pin-drop picker existed.
  deliveryLatitude     Decimal? @db.Decimal(9, 6)
  deliveryLongitude    Decimal? @db.Decimal(9, 6)
  deliveryCharge       Decimal  @default(0) @db.Decimal(12, 2)
  billDetails          Json? // Snapshot of { itemTotal, deliveryCharge, slotExtraCharge, packagingCharge, gstAmount, discount, totalAmount, eventId? }

  status        OrderStatus    @default(PENDING)
  paymentStatus PaymentStatus  @default(PENDING)
  paymentMethod PaymentMethod?
  paymentRef    String?

  // Rider assignment — riderId is a bare reference to the Mongo `staffs`
  // collection (role: RIDER), same cross-DB convention as storeId/userId above.
  riderId         String?
  riderStatus     OrderRiderStatus?
  assignedAt      DateTime?         @db.Timestamptz(3)
  assignedBy      String? // sellerId or staffId (Mongo ObjectId) who assigned the rider
  pickupStartedAt DateTime?         @db.Timestamptz(3) // set when status flips to SHIPPED (rider left the store)
  deliveredAt     DateTime?         @db.Timestamptz(3) // set when status flips to DELIVERED
  // Store to delivery pin, captured once at delivery. Stored rather than
  // derived on read so a rider's day still adds up after an address is edited
  // or a store moves — and so the number a rider is measured on cannot change
  // retroactively. Null when either end had no coordinates.
  deliveryDistanceKm Decimal?       @db.Decimal(6, 2)

  // Cutting Staff prep photos — set when a CUTTING_STAFF staff member marks
  // preparation complete (status flips to READY_FOR_PICKUP). Array of
  // {url, publicId, uploadedAt}.
  preparationPhotos Json?

  // Rider delivery-proof photo — set when a RIDER staff member marks the
  // order delivered. Auto-deleted (Cloudinary asset + these fields nulled)
  // 5 days after upload by a scheduled job.
  deliveryProofPhotoUrl      String?
  deliveryProofPhotoPublicId String?
  deliveryProofUploadedAt    DateTime? @db.Timestamptz(3)

  rejectionReason     String?
  // Who/why/when an order was cancelled — set on any path that flips status
  // to CANCELLED (customer self-cancel, seller/staff cancel, or the system).
  // cancellationReason is free text from staff but one of a fixed quick-pick
  // list from a customer (see cancelOrderSchema).
  cancellationReason  String?
  cancelledBy         CancelledBy?
  cancelledAt         DateTime?    @db.Timestamptz(3)
  // NONE until a refund is actually requested — most cancelled orders (COD,
  // or paid orders cancelled while still unpaid) never touch this.
  refundStatus        RefundStatus @default(NONE)
  // Why the last refund attempt failed, kept so an operator retrying by hand
  // knows whether to retry at all. Written only on the FAILED transitions and
  // cleared whenever a new attempt claims the order.
  refundFailureReason String?
  refundFailedAt      DateTime?    @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  orderItems   OrderItem[]
  payments     Payment[]
  couponUsages CouponUsage[]

  // Postgres serves a query from any leftmost prefix of a compound index, so
  // standalone [userId] / [storeId] indexes would be dead weight on every
  // write. A standalone [status] was dropped too — six enum values over the
  // whole table is not selective enough for the planner to prefer it; the one
  // query that does filter on status (the stale-order sweeper) is served by a
  // partial index created in migration 20260807000001. The co-purchase job's
  // deliveredAt scan is served the same way (migration 20260810000000).
  @@index([userId, createdAt(sort: Desc)]) // user order history with recent-first sort
  @@index([storeId, createdAt(sort: Desc)]) // seller order dashboard + stats range scans
  // Backend console search is by orderNumber, so it has to stand alone rather
  // than ride a prefix of either compound index above. Uniqueness is enforced
  // separately by a partial index (migration 20260831090000) that Prisma
  // cannot express, which is why this is a plain @@index.
  @@index([orderNumber])
  @@index([invoiceNumber])
  // The staff/seller order board filters by the delivery day for a store, which
  // is a different question from createdAt — an order placed yesterday can be
  // due today. Neither existing compound index has this as a prefix.
  @@index([storeId, deliveryDate])
}

// Per-location, per-financial-year counter behind Order.invoiceNumber.
//
// Separate from OrderNumberSequence below because the periods differ and the
// guarantees differ: order numbers restart daily and may be issued for orders
// that never complete, while GST requires invoice numbers to run consecutively
// through a financial year (April–March). Sharing one counter would satisfy
// neither rule.
//
// Advanced with the same atomic INSERT ... ON CONFLICT DO UPDATE ... RETURNING.
model InvoiceSequence {
  locationCode String
  // "2026-27" — the Indian financial year, computed in IST.
  financialYear String
  lastSeq       Int      @default(0)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  @@id([locationCode, financialYear])
}

// How many orders are already committed to one store's slot on one day.
//
// Capacity lives on the row rather than being read from the store's config at
// reserve time, so a seller lowering the cap mid-day cannot retroactively
// invalidate orders already taken against the old one. The row is created with
// whatever the cap was when the day's first order landed.
//
// Claimed with a single INSERT ... ON CONFLICT DO UPDATE ... WHERE booked <
// capacity ... RETURNING. The WHERE is the double-booking guard: two checkouts
// racing for the last place mean one gets a row back and the other gets none,
// with no lock held and no read-then-write window between them.
model DeliverySlotBooking {
  storeId String
  // ddMMyyyy in IST, matching Order.deliveryDate and OrderNumberSequence.
  deliveryDate String
  // "morning" | "evening" — matches Order.deliverySlot. "instant" is never
  // booked here: it is capped by the store's own delivery window, not a count.
  slotKey      String
  booked       Int      @default(0)
  capacity     Int
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@id([storeId, deliveryDate, slotKey])
}

// Per-location, per-day counter behind Order.orderNumber's last segment.
//
// Advanced with a single INSERT ... ON CONFLICT DO UPDATE ... RETURNING, which
// is atomic: two checkouts in the same millisecond take 001 and 002 rather than
// both reading 000. Deriving the next number from MAX(orderNumber) instead
// would race, and would scan.
//
// Rows are never deleted — a day's final count is a business record, and the
// table grows by one row per active location per day.
model OrderNumberSequence {
  locationCode String
  // The date the sequence belongs to, ddMMyyyy, in IST — the store's own
  // calendar day, not UTC's, or the counter would roll over at 05:30 local.
  dateKey      String
  lastSeq      Int      @default(0)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@id([locationCode, dateKey])
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  order            Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String // Reference to Mongo Product ID
  // The catalog root behind productId, denormalised at checkout. productId is
  // the *store variant*, so the same fish sold by four stores is four ids —
  // co-purchase stats aggregated on it would split one product's signal four
  // ways. Resolving it here costs nothing (checkout has already loaded the
  // product) and spares the nightly job a Mongo lookup per row. Null on orders
  // placed before this column existed and on any row the backfill couldn't
  // resolve; the aggregation job skips those rather than guessing.
  catalogProductId String?
  quantity         Int
  price            Decimal @db.Decimal(12, 2)
  selectedOptions  Json?

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id      String        @id @default(cuid())
  orderId String
  order   Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount  Decimal       @db.Decimal(12, 2)
  status  PaymentStatus @default(PENDING)
  method  PaymentMethod

  // The gateway's own payment id (Razorpay payment_id), set on capture.
  transactionId  String? @unique
  // The gateway's order id (Razorpay order_id), bound at checkout creation.
  // Indexed because reconciliation looks payments up by it — it previously
  // lived in `metadata` and could only be found by an unindexed JSON scan.
  gatewayOrderId String? @unique

  metadata Json?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([orderId])
  @@index([status, createdAt]) // reconciliation sweep over stale PENDING rows
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String // Reference to Mongo Coupon ID
  userId    String // Reference to Mongo User ID
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([couponId, userId])
  @@index([orderId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String // Reference to Mongo User ID
  title     String
  message   String
  type      String   @default("INFO") // "INFO", "SUCCESS", "WARNING", "ERROR"
  category  String? // "ORDER", "SYSTEM", "PROMO", etc.
  isRead    Boolean  @default(false)
  metadata  Json? // For deep linking, e.g., { orderId: "..." }
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  // The unread badge queries { userId, isRead: false }. It is served by a
  // partial index on (userId, createdAt) WHERE is_read = false, created in
  // migration 20260807000001 — partial because almost every row ends up read,
  // so the index stays small no matter how much history accumulates.
  @@index([userId, createdAt])
}

// Immutable financial audit trail — never delete rows from this table
model AuditLog {
  id         String          @id @default(cuid())
  entityType AuditEntityType
  entityId   String // orderId, paymentId, etc.
  // Deliberately a String rather than an enum: the action vocabulary grows
  // every time an event is added, and an enum would mean a schema migration
  // for each one. Typo-safety comes from the AuditAction union in audit.ts,
  // which is checked at the call site instead.
  action     String
  actorId    String? // userId, sellerId, adminId — null means system
  actorType  ActorType?
  metadata   Json? // snapshot of relevant data at the time of the event
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)

  // entityId is an id and therefore selective on its own; a compound
  // [entityType, entityId] would narrow almost nothing on top of it. actorId
  // had an index but is only ever written, never filtered on.
  @@index([entityId])
  @@index([action, createdAt(sort: Desc)]) // listPaymentsNeedingAttention
  @@index([createdAt])
}

// Durable record of gateway webhooks. Dedupe used to live only in Redis on a
// TTL, which is a cache, not an audit trail — a replay after eviction would
// re-apply, and there was no record of what the gateway actually sent.
model WebhookEvent {
  id        String @id @default(cuid())
  provider  String // "RAZORPAY"
  eventId   String // the gateway's own event id (x-razorpay-event-id)
  eventType String
  payload   Json

  receivedAt  DateTime  @default(now()) @db.Timestamptz(3)
  // Null means received but not yet applied — either in flight or it failed
  // and the gateway's retry will pick it up. Dedupe keys off this, not mere
  // row existence, so a failed attempt doesn't block the retry.
  processedAt DateTime? @db.Timestamptz(3)

  // The unprocessed set is tiny and the processed set grows without bound, so
  // the sweeper is served by a partial index on (received_at) WHERE
  // processed_at IS NULL (migration 20260807000001) rather than a full index
  // over every webhook ever received.
  @@unique([provider, eventId])
  @@index([receivedAt])
}

// Transactional outbox. Written inside the same Postgres transaction as the
// state change it describes, so "committed" and "will be published" are
// atomic. Publishing straight to RabbitMQ after a commit loses the message if
// the process dies in between.
model OutboxEvent {
  id          String       @id @default(cuid())
  aggregate   String // "ORDER" | "PAYMENT"
  aggregateId String
  eventType   String // "ORDER_CREATED" | "COUPON_APPLIED"
  queue       String // target RabbitMQ queue
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  lastError   String?
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  publishedAt DateTime?    @db.Timestamptz(3)

  // Claimed by the relay so two instances can't publish the same row. Rows are
  // selected FOR UPDATE SKIP LOCKED and stamped; a claim older than the lease
  // window is treated as abandoned and retried.
  lockedAt DateTime? @db.Timestamptz(3)
  lockedBy String?

  // The relay only ever reads PENDING rows and the retention job only ever
  // reads settled ones, so both are served by partial indexes rather than one
  // full index over a table that grows forever (migration 20260807000001).
  @@index([aggregate, aggregateId])
}

// Durable record of a Mongo stock decrement. Stock is reserved in Mongo before
// the Postgres order transaction (so we never sell stock we didn't hold), which
// leaves a window where a crash loses the only record of the reservation. This
// row is written first and marked CONSUMED inside the order transaction; a
// sweeper releases anything left HELD.
model StockReservation {
  id        String                 @id @default(cuid())
  orderId   String? // set once the order transaction commits
  userId    String
  items     Json // [{ productId, quantity }]
  status    StockReservationStatus @default(HELD)
  createdAt DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt DateTime               @updatedAt @db.Timestamptz(3)

  // Like the outbox, the sweeper only reads HELD rows — partial index in
  // migration 20260807000001.
  @@index([orderId])
}

// ── Co-purchase intelligence ─────────────────────────────────────────────────
// Powers "Frequently Bought Together". Aggregated incrementally from delivered
// orders by the nightly job in packages/jobs (co-purchase.job.ts), then read on
// the product page. All three tables are keyed by *catalog* product id (a Mongo
// ObjectId), never a store variant — see the note on OrderItem.catalogProductId.
//
// These are derived data: everything here can be rebuilt from Order/OrderItem
// by resetting CoPurchaseState, which is why nothing else may write to them.

// One row per unordered pair of catalog products that have appeared in the same
// delivered order. The pair is stored once with catalogA < catalogB so a pair
// can never be double-counted under two orderings; reads must therefore look at
// both columns, hence the two indexes.
// Cash a rider took at the door, one row per delivered COD order.
//
// Written when the order flips to DELIVERED rather than derived from Order on
// read: the amount owed is what was collected at that moment, and a later
// refund or edit to the order must not silently change what a rider is holding.
// Reconciliation is about the cash, not about the order's current state.
model CodCollection {
  id      String @id @default(cuid())
  // One collection per order — a second delivery of the same order is a bug,
  // and the unique index is what makes a retried mark-delivered idempotent.
  orderId String @unique
  // Bare references to the Mongo `staffs` and `stores` collections, the same
  // cross-DB convention Order.riderId/storeId already use.
  riderId String
  storeId String

  amount      Decimal  @db.Decimal(12, 2)
  collectedAt DateTime @db.Timestamptz(3)

  // Null until a manager marks the cash received. This is the outstanding
  // balance: sum of amounts where this is null.
  settlementId String?
  settlement   CodSettlement? @relation(fields: [settlementId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  // "What does this rider still owe" — the query the dashboard opens on.
  @@index([riderId, settlementId])
  @@index([storeId, collectedAt(sort: Desc)])
}

// A manager acknowledging cash handed over, covering one or more collections.
//
// Separate from CodCollection so a settlement can cover a partial set: a rider
// who hands over some of what they hold gets the collections they settled
// stamped, and the rest stay outstanding.
model CodSettlement {
  id      String @id @default(cuid())
  riderId String
  storeId String

  amount     Decimal @db.Decimal(12, 2)
  // Denormalised so the history list doesn't need a join per row to say
  // "12 orders, ₹8,400".
  orderCount Int

  // The seller or staff Mongo id that signed off. Who took responsibility for
  // the cash is the whole point of the record.
  settledBy String
  notes     String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  collections CodCollection[]

  @@index([storeId, createdAt(sort: Desc)])
  @@index([riderId, createdAt(sort: Desc)])
}

// A rider's shift check-in: a selfie and a location, taken at the store.
//
// The computed distance is stored alongside the raw coordinates rather than
// only the pass/fail, so a disputed check-in can be re-examined against the
// numbers that were actually used instead of re-derived against a store pin
// that may have moved since.
model StaffAttendance {
  id      String @id @default(cuid())
  staffId String
  storeId String

  checkInAt  DateTime  @db.Timestamptz(3)
  checkOutAt DateTime? @db.Timestamptz(3)

  selfieUrl      String
  selfiePublicId String

  latitude  Decimal @db.Decimal(9, 6)
  longitude Decimal @db.Decimal(9, 6)
  // Metres from the store at check-in, and whether that was inside the fence.
  // Out-of-range attempts are recorded, not discarded — "the rider tried to
  // check in from 4km away" is exactly what a manager needs to see.
  distanceMeters   Int
  isWithinGeofence Boolean

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  // The manager's daily roster view, and one person's own history.
  @@index([storeId, checkInAt(sort: Desc)])
  @@index([staffId, checkInAt(sort: Desc)])
}

model ProductCoPurchase {
  catalogA   String
  catalogB   String
  orderCount Int      @default(0)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@id([catalogA, catalogB])
  @@index([catalogA, orderCount(sort: Desc)])
  @@index([catalogB, orderCount(sort: Desc)])
}

// Orders containing this catalog product, counted once per order regardless of
// quantity or how many of its variants the order held. Denominator for the
// conditional probability P(B | A) and one of the two marginals in lift.
model ProductOrderStat {
  catalogProductId String   @id
  orderCount       Int      @default(0)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)
}

// Single-row aggregation cursor. lastDeliveredAt is the high-water mark over
// Order.deliveredAt; totalOrders is the population size lift is computed
// against. Advanced in the same transaction as the counters it accompanies, so
// a crashed run resumes without double-counting the batch it was mid-way
// through. Deleting this row is the supported way to force a full rebuild
// (truncate the two tables above first, or the counts will double).
model CoPurchaseState {
  id              String    @id @default("singleton")
  lastDeliveredAt DateTime? @db.Timestamptz(3)
  totalOrders     Int       @default(0)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
}
