generator client {
  provider      = "prisma-client-js"
  output        = "./generated-client"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-arm64-openssl-1.1.x", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

enum OrderStatus {
  PENDING
  ACCEPTED
  REJECTED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  // Refund submitted to the gateway but not yet settled. Gateway refunds are
  // asynchronous and can still fail, so REFUNDED is only set once the
  // refund.processed webhook confirms it.
  REFUND_PENDING
  REFUNDED
}

model Order {
  id      String @id @default(cuid())
  userId  String // Reference to Mongo User ID
  storeId String // Reference to Mongo Store ID

  totalAmount    Float
  discountAmount Float   @default(0)
  couponCode     String?
  deliverySlot   String? // "instant" | "morning" | "evening"

  // Delivery details
  deliveryName    String?
  deliveryPhone   String?
  deliveryAddress String?
  deliveryCity    String?
  deliveryPincode String?
  deliveryCharge  Float   @default(0)
  billDetails     Json? // Snapshot of { itemTotal, deliveryCharge, discount, totalAmount }

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod String?
  paymentRef    String?

  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems   OrderItem[]
  payments     Payment[]
  couponUsages CouponUsage[]

  @@index([storeId])
  @@index([userId])
  @@index([status])
  @@index([userId, createdAt(sort: Desc)]) // user order history with recent-first sort
  @@index([storeId, createdAt(sort: Desc)]) // seller order dashboard
}

model OrderItem {
  id              String @id @default(cuid())
  orderId         String
  order           Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String // Reference to Mongo Product ID
  quantity        Int
  price           Float
  selectedOptions Json?

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount  Float
  status  PaymentStatus @default(PENDING)
  method  String // "COD", "RAZORPAY", etc.

  // The gateway's own payment id (Razorpay payment_id), set on capture.
  transactionId String? @unique
  // The gateway's order id (Razorpay order_id), bound at checkout creation.
  // Indexed because reconciliation looks payments up by it — it previously
  // lived in `metadata` and could only be found by an unindexed JSON scan.
  gatewayOrderId String? @unique

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([status, createdAt]) // reconciliation sweep over stale PENDING rows
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String // Reference to Mongo Coupon ID
  userId    String // Reference to Mongo User ID
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([couponId, userId])
  @@index([orderId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String // Reference to Mongo User ID
  title     String
  message   String
  type      String   @default("INFO") // "INFO", "SUCCESS", "WARNING", "ERROR"
  category  String? // "ORDER", "SYSTEM", "PROMO", etc.
  isRead    Boolean  @default(false)
  metadata  Json? // For deep linking, e.g., { orderId: "..." }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

// Immutable financial audit trail — never delete rows from this table
model AuditLog {
  id         String   @id @default(cuid())
  entityType String // "ORDER" | "PAYMENT" | "COUPON" | "STOCK" | "REFUND"
  entityId   String // orderId, paymentId, etc.
  action     String // "ORDER_CREATED" | "PAYMENT_INITIATED" | "PAYMENT_VERIFIED" | "PAYMENT_FAILED" | "ORDER_STATUS_CHANGED" | "STOCK_RESERVED" | "COUPON_APPLIED" | "REFUND_INITIATED"
  actorId    String? // userId, sellerId, adminId — null means system
  actorType  String? // "USER" | "SELLER" | "ADMIN" | "SYSTEM"
  metadata   Json? // snapshot of relevant data at the time of the event
  createdAt  DateTime @default(now())

  @@index([entityId])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// Durable record of gateway webhooks. Dedupe used to live only in Redis on a
// TTL, which is a cache, not an audit trail — a replay after eviction would
// re-apply, and there was no record of what the gateway actually sent.
model WebhookEvent {
  id        String @id @default(cuid())
  provider  String // "RAZORPAY"
  eventId   String // the gateway's own event id (x-razorpay-event-id)
  eventType String
  payload   Json

  receivedAt DateTime  @default(now())
  // Null means received but not yet applied — either in flight or it failed
  // and the gateway's retry will pick it up. Dedupe keys off this, not mere
  // row existence, so a failed attempt doesn't block the retry.
  processedAt DateTime?

  @@unique([provider, eventId])
  @@index([receivedAt])
  @@index([processedAt])
}

// Transactional outbox. Written inside the same Postgres transaction as the
// state change it describes, so "committed" and "will be published" are
// atomic. Publishing straight to RabbitMQ after a commit loses the message if
// the process dies in between.
model OutboxEvent {
  id          String    @id @default(cuid())
  aggregate   String // "ORDER" | "PAYMENT"
  aggregateId String
  eventType   String // "ORDER_CREATED" | "COUPON_APPLIED"
  queue       String // target RabbitMQ queue
  payload     Json
  status      String    @default("PENDING") // PENDING | PUBLISHED | FAILED
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  @@index([status, createdAt])
  @@index([aggregate, aggregateId])
}

// Durable record of a Mongo stock decrement. Stock is reserved in Mongo before
// the Postgres order transaction (so we never sell stock we didn't hold), which
// leaves a window where a crash loses the only record of the reservation. This
// row is written first and marked CONSUMED inside the order transaction; a
// sweeper releases anything left HELD.
model StockReservation {
  id        String   @id @default(cuid())
  orderId   String? // set once the order transaction commits
  userId    String
  items     Json // [{ productId, quantity }]
  status    String   @default("HELD") // HELD | CONSUMED | RELEASED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([orderId])
}
