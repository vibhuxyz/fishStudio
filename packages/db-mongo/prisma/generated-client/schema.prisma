generator client {
  provider      = "prisma-client-js"
  output        = "./generated-client"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-arm64-openssl-1.1.x", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("MONGO_URL")
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum ImageType {
  PRODUCT
  USER_AVATAR
  STORE_AVATAR
  RIDER_AVATAR
}

enum RiderVehicleType {
  BIKE
  SCOOTER
  BICYCLE
  OTHER
}

enum RiderStatus {
  AVAILABLE
  DELIVERING
  OFFLINE
  ON_LEAVE
}

enum StaffRole {
  ORDER_MANAGER
  RIDER
  CUTTING_STAFF
}

enum productStatus {
  Active
  NonActive
}

enum sellerEventType {
  FREE_DELIVERY
  DISCOUNT
  FLASH_SALE
}

model admins {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String           @unique
  password  String
  products  products[]
  coupons   discount_codes[]
  banners   banners[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

//////////////////////////////////////////////////////
// IMAGES (NO BACK-RELATIONS TO USER / STORE)
//////////////////////////////////////////////////////

model images {
  id      String    @id @default(auto()) @map("_id") @db.ObjectId
  file_id String
  url     String
  type    ImageType @default(PRODUCT)

  // Link to Product
  productId String?   @db.ObjectId
  // Fix applied here to break the cycle
  product   products? @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now())
  users     users[]
  stores    stores[]
  staffs    staffs[]

  @@unique([productId, file_id])
  @@index([productId])
}

//////////////////////////////////////////////////////
// USERS
//////////////////////////////////////////////////////

model users {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  phone_number String?
  email        String?
  name         String
  following    String[]
  addresses    Json[] // Array of { id, name, phone, street, city, state, pincode, isDefault }

  avatarId String? @db.ObjectId
  avatar   images? @relation(fields: [avatarId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  favorites favorites[]
  reviews   reviews[]

  // Lazily generated on first read (getUser) rather than at signup, so
  // existing accounts pick one up the first time they need it instead of
  // needing a backfill.
  referralCode String?

  // The *other* person's code, captured at signup — distinct from
  // referralCode above, which is this user's own shareable code. Lets
  // createOrder grant the referrer's reward on this user's first order even
  // if they don't also re-type it in the checkout referral field.
  referredByCode String?

  // Set from the notification-permissions onboarding screen. Null means the
  // user was never asked (older accounts, or they dismissed the prompt).
  expoPushToken             String?
  emailNotificationsEnabled Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Uniqueness for non-null email / phone_number / referralCode is enforced by
  // sparse unique indexes, which Prisma cannot express. They are declared in
  // src/ensure-indexes.ts and applied by `pnpm --filter @repo/db-mongo
  // db:indexes` — not by db push.
  @@index([email])
  @@index([phone_number])
}

model discount_codes {
  id                String @id @default(auto()) @map("_id") @db.ObjectId
  public_name       String
  discountType      String // "percentage" | "fixed" | "free_delivery"
  discountValue     Float
  // Ceiling on the rupee amount a percentage coupon can knock off — without
  // this, "20% off" on a large order has no upper bound. Ignored for fixed
  // (already capped at order value) and free_delivery (no rupee value).
  maxDiscountAmount Float?
  minOrderValue     Float  @default(0)
  discountCode      String @unique

  // New fields for better control
  expiresAt      DateTime? // null = never expires
  maxUses        Int? // null = unlimited total uses
  maxUsesPerUser Int       @default(1) // per-user limit
  usedCount      Int       @default(0) // total times used
  isActive       Boolean   @default(true)
  isFirstOrder   Boolean   @default(false) // lifetime: only usable if user has no prior orders at this store

  sellerId String?         @db.ObjectId
  adminId  String?         @db.ObjectId
  seller   sellers?        @relation(fields: [sellerId], references: [id])
  admin    admins?         @relation(fields: [adminId], references: [id])
  usages   coupon_usages[]

  // Set only on system-generated referral rewards — restricts redemption to
  // the one user it was issued to, instead of every customer of the store.
  restrictedToUserId String? @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId])
  @@index([restrictedToUserId])
}

model coupon_usages {
  id       String         @id @default(auto()) @map("_id") @db.ObjectId
  couponId String         @db.ObjectId
  coupon   discount_codes @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId   String         @db.ObjectId
  orderId  String // Keep as string reference to Postgres
  usedAt   DateTime       @default(now())

  @@index([couponId, userId])
  @@map("coupon_usages")
}

//////////////////////////////////////////////////////
// SELLERS
//////////////////////////////////////////////////////

model sellers {
  id           String           @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String           @unique
  phone_number String
  password     String
  following    String[]
  banners      banners[]
  events       seller_events[]
  store        stores?
  coupons      discount_codes[]
  staffs       staffs[]

  isApprovedByAdmin Boolean @default(false)
  permissions       Json?
  // Admin kill-switch: deactivating a seller blocks their login/dashboard and
  // cascades their store's products to NonActive (see updateSellerApproval).
  isActive          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isApprovedByAdmin, createdAt]) // hourly cleanup query
  @@index([isActive])
}

//////////////////////////////////////////////////////
// STAFFS
//////////////////////////////////////////////////////

model staffs {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  // Self-signup (OTP) staff — the ORDER_MANAGER flow — log in with email.
  // Seller-direct-created RIDER/CUTTING_STAFF log in with username instead.
  // Exactly one of the two is set depending on how the account was created.
  email    String?
  username String?
  password String
  phone    String?
  isActive Boolean   @default(false)
  role     StaffRole @default(ORDER_MANAGER)

  photoId String? @db.ObjectId
  photo   images? @relation(fields: [photoId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  sellerId String?  @db.ObjectId
  seller   sellers? @relation(fields: [sellerId], references: [id])

  // Only set for role: RIDER — mirrors the store scoping the old `riders`
  // collection had, needed so eligible-rider assignment queries can filter
  // by the seller's store.
  storeId String? @db.ObjectId
  store   stores? @relation(fields: [storeId], references: [id])

  // Rider-only fields (role: RIDER). Ported from the retired `riders` model.
  vehicleType         RiderVehicleType?
  vehicleNumber       String?
  deliveryZone        String?
  riderStatus         RiderStatus?      @default(AVAILABLE)
  // Single-active-delivery-per-rider is the assumed business rule: the
  // assignment eligibility query only ever returns AVAILABLE riders, so this
  // count should only ever be 0 or 1 in practice today — kept as an Int
  // rather than a Boolean so a future multi-delivery relaxation doesn't need
  // a schema change.
  activeDeliveryCount Int?              @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Both the full roster view and the "eligible for assignment" query
  // (storeId + role=RIDER + riderStatus=AVAILABLE) filter on these together.
  @@index([storeId, role, riderStatus])
  @@index([sellerId, role])
}

//////////////////////////////////////////////////////
// STORES
//////////////////////////////////////////////////////

model stores {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String
  bio  String

  avatarId String? @db.ObjectId
  // Fix applied here to break the cycle
  avatar   images? @relation(fields: [avatarId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  address       String
  city          String
  pincode       String
  // The store's own map pin. Serviceability is still decided by pincode/area
  // lists, not by radius — these exist so a distance can be measured from the
  // store: the rider attendance geofence, and delivery distance per order.
  // Null for a store whose pin has never been dropped.
  latitude      Float?
  longitude     Float?
  opening_hours String // e.g. "09:00"
  closing_hours String // e.g. "23:00"

  // Instant Delivery Settings
  is_instant_delivery_enabled   Boolean @default(true)
  instant_delivery_fee          Float   @default(20)
  instant_delivery_window_start String  @default("11:00")
  instant_delivery_window_end   String  @default("19:00")

  // Scheduled Delivery Slots
  //
  // Array of { key, label, startTime, endTime, cutoffMinutesBefore, capacity }.
  // Json rather than columns because a store may run two slots or five, and the
  // set is edited as a whole in seller settings — the alternative is a second
  // collection whose only reader is this one document.
  //
  // Null means "not configured", which falls back to DEFAULT_DELIVERY_SLOTS in
  // packages/shared/src/delivery-slots so an existing store keeps trading on
  // the morning/evening pair it already had.
  //
  // "instant" is deliberately not in here: it is bounded by the delivery window
  // above and by whether the store is open, not by a per-day count.
  deliverySlotConfig Json?

  // Bill Settings — packaging/GST/delivery are seller-configured per store so
  // the amount quoted pre-checkout and the amount order-service charges can
  // never disagree; see computeCartSummary in packages/shared/src/pricing.
  gst_rate                Float @default(0)
  packaging_charge        Float @default(0)
  base_delivery_charge    Float @default(49)
  free_delivery_threshold Float @default(500)

  // ── Tax invoice identity ────────────────────────────────────────────
  // What a GST invoice must show about the supplier. These are the operating
  // company's details, which are not the same as the customer-facing store
  // name/address above — a shop trading as "Fish Studio Noida" still invoices
  // as its registered legal entity.
  //
  // All nullable: a store that has not been given them yet simply cannot have
  // an invoice raised (invoiceForOrder refuses rather than printing a document
  // with a blank GSTIN, which would be worse than none at all).
  legalName           String?
  gstin               String?
  fssaiLicenseNumber  String?
  registeredAddress   String?
  // City named in the "SUBJECT TO <CITY> JURISDICTION" footer. Usually, but
  // not always, the store's own city — jurisdiction follows the registered
  // office, not the delivery hub.
  invoiceJurisdiction String?

  // Short location code for this store's human-facing order numbers, e.g.
  // "NOI" for Noida — the middle segment of FS-NOI-30082026-001. Set by the
  // admin rather than derived from `city`, because two cities can shorten to
  // the same three letters and because a city rename must not silently change
  // the numbers already printed on customers' invoices.
  //
  // Null until an admin sets it: orders at such a store still go through, they
  // just carry no orderNumber (see the note on Order.orderNumber in the
  // Postgres schema).
  locationCode       String?
  // Cap above which a COD order needs the seller to phone the customer before
  // accepting. At or below it, and for any order already paid online, the
  // order is auto-accepted — the seller's Accept button exists for the risky
  // tail, not for every order. Null falls back to DEFAULT_COD_AUTO_ACCEPT_LIMIT.
  codAutoAcceptLimit Float?

  // How many orders one rider may carry at once. Batching nearby drops is the
  // whole point; the cap is what stops a dispatcher handing one rider the
  // entire evening. Null falls back to DEFAULT_MAX_CONCURRENT_DELIVERIES.
  maxConcurrentDeliveries Int?

  // How close to the store a rider must be to check in, in metres.
  //
  // Tunable per store because the right value is a property of the site, not of
  // the platform: a standalone unit with the pin on its door is not a stall
  // inside a market building where GPS bounces off everything. Null falls back
  // to ATTENDANCE_GEOFENCE_METERS. The attendance dashboard reports the
  // distances actually recorded, which is what this should be set from.
  attendanceGeofenceMeters Int?

  availableCities   String[] // Areas/localities served by this store, e.g. ["Sector 20", "Tugal Pur"]
  cityDeliveryTimes Json? // Map of area name -> delivery minutes e.g. {"Sector 20": 40, "Tugal Pur": 13}
  // A single pincode (e.g. 201301) can span several localities with very
  // different real delivery times, so each area is pinned to the pincode it
  // actually falls under — this is what lets checkPincode/resolvePreferredStore
  // match a customer's raw pincode even though delivery time is looked up by area.
  areaPincodes      Json? // Map of area name -> pincode e.g. {"Sector 20": "201301", "Tugal Pur": "201306"}
  // A pincode's areas can sit in different actual cities (e.g. "Kavi Nagar"
  // under 201001 is Ghaziabad, not the store's own base city) — without this,
  // the address form always showed the store's single base city regardless
  // of which area/pincode the customer actually picked.
  areaCities        Json? // Map of area name -> its real city e.g. {"Kavi Nagar": "Ghaziabad", "Sector 20": "Noida"}
  servicePincodes   String[] @default([]) // Distinct pincodes derived from areaPincodes, used for fast "does this store serve X" lookups
  state             String? // State of the store location

  // Support / Contact Configuration — surfaced to customers on order-detail
  // screens (Call Support / Chat on WhatsApp). All optional: a store with
  // none of these set falls back to platform-level defaults on the client.
  supportPhone            String?
  whatsappNumber          String?
  whatsappLink            String? // optional full wa.me override; if unset, built from whatsappNumber
  whatsappMessageTemplate String? // optional override of the default order-details template
  supportEmail            String?
  supportHours            String? // free text, e.g. "9 AM – 9 PM, all days"
  supportDescription      String?
  faqLink                 String?

  sellerId String  @unique @db.ObjectId
  seller   sellers @relation(fields: [sellerId], references: [id])

  products products[]
  combos   combos[]
  staffs   staffs[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // resolvePreferredStore (storefront.utils.ts) filters on these on nearly
  // every uncached storefront/homepage/activity request.
  @@index([pincode])
  @@index([city])
  @@index([servicePincodes])
}

//////////////////////////////////////////////////////
// FAVORITES
//////////////////////////////////////////////////////

model favorites {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  userId    String @db.ObjectId
  productId String @db.ObjectId

  user    users    @relation(fields: [userId], references: [id])
  product products @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model reviews {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  userId    String @db.ObjectId
  productId String @db.ObjectId

  user    users    @relation(fields: [userId], references: [id])
  product products @relation(fields: [productId], references: [id])

  rating  Int // 1-5
  comment String?
  images  String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([productId, createdAt])
}

//////////////////////////////////////////////////////
// SITE CONFIG
//////////////////////////////////////////////////////

model site_config {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  categories        String[]
  subCategories     Json
  categoryImages    Json     @default("{}")
  // Keyed by category name -> isActive. Absent entries are treated as active
  // (existing categories predate this field).
  categoryStatus    Json     @default("{}")
  // Keyed by "<category>::<subCategory>" -> isActive, same absent-is-active rule.
  subCategoryStatus Json     @default("{}")

  // Which map/geocoding backend the storefront and app use: "osm" or "google".
  //
  // Config rather than an env var because switching it is a business decision
  // with a bill attached, and it has to be reversible without a redeploy — if
  // Google billing lapses or a key is revoked, an admin needs to fall back to
  // OSM immediately. Null means "use whatever the build was configured with".
  mapProvider String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_config")
}

//////////////////////////////////////////////////////
// PRODUCTS
//////////////////////////////////////////////////////

model products {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  title             String
  slug              String? @unique
  isCatalog         Boolean @default(false)
  category          String
  subCategory       String
  short_description String

  // HSN code for the tax invoice, e.g. "3025900" for fresh fish. Authored on
  // the catalog root and inherited by every store variant — the code describes
  // the goods, not who is selling them, so holding it per variant would let
  // one product be classified two ways.
  //
  // Null on products predating this field; the invoice prints "—" rather than
  // guessing a code, since a wrong HSN is a tax misclassification.
  hsnCode        String?
  // Overrides the store's blanket gst_rate for this product, as a percentage
  // (0 for exempt fresh fish, 5, 12, 18). Null falls back to the store rate.
  // A percentage here, unlike stores.gst_rate which is a fraction — the two
  // are never mixed: computeInvoice converts before use.
  gstRatePercent Float?

  images images[]

  tags               String[]
  sizes              String[]
  sizePricing        Json?
  cuttingTypePricing Json?
  pieceSizePricing   Json?
  cuttingTypes       String[]
  pieceSizes         String[]

  // Weight-based pricing configuration
  basePricePerKg   Float?
  basePricePerUnit Float?
  pricingMethod    String? // "per_kg", "per_piece", "fixed"

  // Whole-fish style products: admin flags the catalog product as sold by
  // exact weight, so stock is tracked per size instead of one shared pool.
  // trackStockPerSize is set on the catalog root; sizeStock is populated on
  // the seller's store variant once they add it.
  //
  // sizeStock is an array of { size, qty }, NOT a { [size]: qty } map: size
  // labels like "1.1 kg" contain literal dots, which Mongo would read as
  // nested-path separators in a dot-notation update. As an array the size is
  // only ever compared, never used as a path segment, which is what lets
  // decrementStockItem do an atomic $inc via arrayFilters.
  trackStockPerSize Boolean @default(false)
  sizeStock         Json?

  processingWeightLoss String?
  stock                Int
  sale_price           Float
  regular_price        Float
  totalSold            Int     @default(0)

  // Merchandising. Admin-controlled display order, independent of createdAt and
  // totalSold — those describe what the catalogue *is*, these say what the
  // business wants promoted.
  //
  // Ascending: 1 shows before 2. Null means unranked and sorts after everything
  // ranked, so setting a rank on one product does not push every other product
  // into an arbitrary order.
  sortOrder  Int?
  isFeatured Boolean     @default(false)
  favorites  favorites[]
  ratings    Float       @default(5)
  reviews    reviews[]

  // Product detail page content (catalog-root authored, inherited by variants)
  origin               String?
  source               String? // e.g. "Freshwater", "Saltwater", "Farmed"
  shelfLife            String? // e.g. "1-2 Days"
  storageInstructions  String? // e.g. "Keep refrigerated (0-4°C)"
  cookingTips          String[]
  highlightDescription String? // "What makes it great?" copy
  nutritionProtein     String? // e.g. "18g"
  nutritionOmega3      String? // e.g. "1.2g"
  nutritionCalories    String? // e.g. "120 kcal"

  cashOnDelivery String?
  discount_codes String[]      @db.ObjectId
  status         productStatus @default(Active)
  isDeleted      Boolean?      @default(false)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  storeId String? @db.ObjectId
  store   stores? @relation(fields: [storeId], references: [id])
  adminId String? @db.ObjectId
  admin   admins? @relation(fields: [adminId], references: [id])

  catalogProductId String?    @db.ObjectId
  catalogProduct   products?  @relation("catalog_variants", fields: [catalogProductId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  storeVariants    products[] @relation("catalog_variants")

  // Mongo can serve a query from any prefix of a compound index, so the
  // standalone [storeId], [adminId] and [catalogProductId] indexes that used
  // to sit here were fully covered by the compounds below. On a collection
  // written on every stock decrement, each redundant index is pure write cost.
  // [totalSold] alone went too — bestseller sort is always scoped by
  // adminId+isDeleted and is served by the compound further down.
  @@index([storeId, status, isDeleted]) // storefront store-product queries
  @@index([adminId, isDeleted, status]) // catalog root product queries
  @@index([catalogProductId, status, isDeleted]) // variant lookup by catalog ID
  @@index([category, status]) // category browse
  // Featured rails: the homepage asks for one store's featured products in
  // rank order, which no existing compound serves as a prefix.
  @@index([storeId, isFeatured, sortOrder])
  @@index([status, isDeleted]) // admin product listing
  // getStoreProducts (storefront.controller.ts) filters catalogWhere on
  // adminId+isDeleted and sorts by these — without a matching compound
  // index Mongo can only use adminId/isDeleted as a filter and falls back to
  // an in-memory sort over the whole filtered set on every cache miss.
  @@index([adminId, isDeleted, totalSold, createdAt]) // homepage sort (isHomepage: true)
  @@index([adminId, isDeleted, createdAt]) // default listing sort
}

model banners {
  id              String  @id @default(auto()) @map("_id") @db.ObjectId
  imageUrl        String
  fileId          String
  isActive        Boolean @default(false)
  category        String?
  status          String? @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason String?

  // Announcement banner fields
  bannerType String? @default("homepage") // "homepage" | "category" | "announcement"
  title      String?
  subtitle   String?
  price      String? // Display price e.g. "169", "199+"

  // Link to Seller or Admin
  sellerId String?  @db.ObjectId
  seller   sellers? @relation(fields: [sellerId], references: [id])
  adminId  String?  @db.ObjectId
  admin    admins?  @relation(fields: [adminId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId])
  @@index([bannerType, isActive, status])
  @@index([category, isActive])
  @@map("banners")
}

model seller_events {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  sellerId    String          @db.ObjectId
  seller      sellers         @relation(fields: [sellerId], references: [id])
  title       String
  description String?
  type        sellerEventType
  minOrder    Float?
  discount    Float?
  startTime   DateTime
  endTime     DateTime
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Equality-Sort-Range: sellerId and isActive are equality matches and must
  // precede the startTime/endTime range, otherwise isActive is only evaluated
  // after the index scan has already fetched the documents. This serves the
  // active-event lookup on the storefront, which runs on every uncached
  // request.
  //
  // The seller dashboard list (event.controller.ts) filters sellerId alone and
  // sorts by startTime, so isActive sitting in the middle costs it an
  // index-ordered sort. That's deliberate: a single seller has tens of events,
  // so Mongo sorts them in memory for nothing, and a second index to avoid it
  // would be paid for on every write.
  @@index([sellerId, isActive, startTime])
  @@map("seller_events")
}

// A combo is a fixed bundle of existing products sold together at one
// bundle price. Each item pins a productId + quantity; cuttingType/pieceSize
// are optional per item — when set, that component is fixed to that variant,
// when left null the shopper picks it themselves at add-to-cart time (same
// options the underlying product itself offers).
model combos {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  images      String[] // Cloudinary URLs

  items Json // ComboItem[]: [{ productId, quantity, cuttingType?, pieceSize? }]

  // regularTotal is a snapshot of the components' combined regular price at
  // creation/update time — used only to show the struck-through "you save"
  // comparison; comboPrice is what the customer is actually ever charged.
  regularTotal Float
  comboPrice   Float
  isActive     Boolean @default(true)

  storeId String @db.ObjectId
  store   stores @relation(fields: [storeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // [isActive] alone was two-valued and never selective; combos are always
  // looked up within a store.
  @@index([storeId, isActive])
}

// SIGNUP ACCESS
//////////////////////////////////////////////////////

model SignupAccessCode {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  email     String?
  role      String // "ADMIN" or "SELLER"
  code      String
  plainCode String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Uniqueness for non-null emails is enforced via sparse indexes created directly
  // in MongoDB: db.signup_access_codes.createIndex({email:1, role:1},{unique:true,sparse:true})
  @@index([email, role])
  @@map("signup_access_codes")
}

//////////////////////////////////////////////////////
// CART
//////////////////////////////////////////////////////

// The user's live cart, and the single source of truth for cart state across
// web and Android. Written on every cart mutation by validateCart (the one
// server touchpoint both clients already go through) and read back by
// GET /product/api/cart when a user signs in on another device.
//
// Lines are stored in the platform-neutral shape validateCartSchema defines
// ({ productId, quantity, cuttingType?, pieceSize?, size?, comboId? }) — ids
// and names only, never a product snapshot. Price, stock, title and image are
// rehydrated through validateCart on read, so a cart restored a week later
// can never show a stale price.
//
// It doubles as the abandoned-cart reminder record (isConverted/notifyStage),
// which is what this collection was originally built for.
model carts {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  userId      String    @db.ObjectId
  items       Json[]
  storeId     String?   @db.ObjectId
  storeName   String?
  totalAmount Float     @default(0)
  notifiedAt  DateTime?
  isConverted Boolean   @default(false)

  // Index into the reminder schedule in checkAbandonedCarts (1h, 3h, 1d, 3d,
  // 1w) — how many of those have already fired since lastUpdatedAt. Reset to
  // 0 whenever the cart's items actually change, so a fresh edit restarts
  // the whole sequence instead of picking up mid-way through the old one.
  notifyStage Int @default(0)

  lastUpdatedAt DateTime @default(now()) @updatedAt
  createdAt     DateTime @default(now())

  // One open cart per user — validateCart upserts on every cart change.
  @@unique([userId])
  @@index([isConverted, notifyStage, lastUpdatedAt])
  @@map("carts")
}

//////////////////////////////////////////////////////
// PRODUCT VIEWS (user activity → recently viewed + recommendations)
//////////////////////////////////////////////////////

model product_views {
  id               String  @id @default(auto()) @map("_id") @db.ObjectId
  // One of userId / deviceId is always present. Guests are tracked by
  // deviceId and merged into userId on login (see mergeActivity).
  userId           String? @db.ObjectId
  deviceId         String? // anonymous device identifier for logged-out users
  productId        String  @db.ObjectId // the variant/displayed product id
  catalogProductId String? @db.ObjectId // catalog root — used for affinity + dedupe
  category         String?
  subCategory      String?
  source           String? // "mobile" | "web"

  createdAt DateTime @default(now())

  // TTL: documents auto-expire ~90 days after creation. Prisma cannot express
  // a Mongo TTL index, so it is declared in src/ensure-indexes.ts and applied
  // by `pnpm --filter @repo/db-mongo db:indexes`.
  @@index([userId, createdAt])
  @@index([deviceId, createdAt])
  @@index([catalogProductId])
  @@map("product_views")
}
