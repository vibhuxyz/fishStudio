ORDER_SERVICE_PORT=6004
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
NODE_ENV=development

# Postgres (orders, order items, payments, audit log — source of truth for order state)
POSTGRES_URL=

# MongoDB (users, stores, products — hydrated into order responses)
MONGO_URL=

# Redis (per-user order rate limiting, create-order idempotency keys, seller/admin stats cache)
REDIS_DATABASE_URL=redis://localhost:6379

# RabbitMQ (ORDER_EVENTS + NOTIFICATION_QUEUE publishing)
RABBITMQ_PROTOCOL=amqp
RABBITMQ_HOST_NAME=localhost
RABBITMQ_USER_NAME=
RABBITMQ_PASSWORD=
RABBITMQ_PORT=5672
