NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_CORS_URL=http://localhost:3000
NEXT_PUBLIC_SERVICE_PORT=3000
NEXT_PUBLIC_WORKER_WS_URL=ws://localhost:8080

# "google" switches location search + the map picker to Google Maps.
# Leave unset (or "osm") to keep the default Leaflet/OpenStreetMap setup,
# which needs no API key.
NEXT_PUBLIC_MAP_PROVIDER=osm
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
