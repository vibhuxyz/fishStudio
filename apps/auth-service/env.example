AUTH_SERVICE_PORT=6001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
NODE_ENV=development

# JWT
ACCESS_TOKEN_JWT_SECRET_KEY=
REFRESH_TOKEN_JWT_SECRET_KEY=

# Redis (rate limiting, OTP state, token blocklist, auth cache)
REDIS_DATABASE_URL=redis://localhost:6379

# RabbitMQ (OTP + notification queues)
RABBITMQ_PROTOCOL=amqp
RABBITMQ_HOST_NAME=localhost
RABBITMQ_USER_NAME=
RABBITMQ_PASSWORD=
RABBITMQ_PORT=5672

# SMS OTP (required in production for phone-number login)
FAST2SMS_API_KEY=

# Cloudinary (profile avatar uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Sign-In (customers). The *Web* OAuth client ID — the same value the
# web app and the mobile app send tokens for. Comma-separate to accept several.
# Public, not a secret. Leave empty to turn Google sign-in off (route answers 503).
GOOGLE_CLIENT_ID=
