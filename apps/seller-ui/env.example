NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_CORS_URL=http://localhost:3002
NEXT_PUBLIC_SERVICE_PORT=3002
# REQUIRED in production. Inlined at BUILD time, so it must be set in the
# deploy environment's build settings and the app rebuilt — not injected at
# runtime. Unset in prod, the app falls back to https://fishstudio.in and logs
# a warning. Local dev: point it at the storefront on localhost.
NEXT_PUBLIC_USER_UI_LINK=http://localhost:3000
NEXT_PUBLIC_WORKER_WS_URL=ws://localhost:8080
NEXT_PUBLIC_CHATTING_WEBSOCKET_URI=ws://localhost:8080
