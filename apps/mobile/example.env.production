EXPO_PUBLIC_API_URL=https://api.fishstudio.in
EXPO_PUBLIC_SERVER_URI=https://api.fishstudio.in
EXPO_PUBLIC_CHATTING_WEBSOCKET_URI=wss://api.fishstudio.in/

# Google Sign-In. WEB client ID = GOOGLE_CLIENT_ID on the auth-service (it is the
# audience the server verifies). IOS client ID is only needed for iOS builds; it
# also feeds the URL scheme in app.config.js. Both are public identifiers.
# Leave the web ID empty and the login screen keeps its "coming soon" button.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
