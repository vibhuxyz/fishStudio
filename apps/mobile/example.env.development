# Local api-gateway. axiosInstance rewrites localhost to the Expo dev-server LAN
# host at runtime, so this also works on a physical device / Android emulator.
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_SERVER_URI=http://localhost:8080

# EXPO_PUBLIC_CHATTING_WEBSOCKET_URI is left unset on purpose: the WebSocket
# provider derives ws://<expo-host>:6006 itself, and setting it here would pin
# the socket to localhost on devices that can't reach it.
