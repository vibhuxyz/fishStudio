# Local api-gateway. axiosInstance rewrites localhost to the Expo dev-server LAN
# host at runtime, so this also works on a physical device / Android emulator.
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_SERVER_URI=http://localhost:8080

# EXPO_PUBLIC_CHATTING_WEBSOCKET_URI is left unset on purpose: the WebSocket
# provider derives ws://<expo-host>:6006 itself, and setting it here would pin
# the socket to localhost on devices that can't reach it.

# Google Sign-In. WEB client ID = GOOGLE_CLIENT_ID on the auth-service (it is the
# audience the server verifies). IOS client ID is only needed for iOS builds; it
# also feeds the URL scheme in app.config.js. Both are public identifiers.
# Leave the web ID empty and the login screen keeps its "coming soon" button.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
