# Primary: EXPO_PUBLIC_API_URL, Fallback: EXPO_PUBLIC_SERVER_URI, Default: http://localhost:8080
# Local api-gateway. axiosInstance rewrites localhost to the Expo dev-server LAN
# host at runtime, so this also works on a physical device / Android emulator.
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_SERVER_URI=http://localhost:8080

# WebSocket URL — leave unset in dev so the provider can derive
# ws://<expo-host>:6006 itself. Production builds get wss://api.fishstudio.in/
# from eas.json.
# EXPO_PUBLIC_CHATTING_WEBSOCKET_URI=
