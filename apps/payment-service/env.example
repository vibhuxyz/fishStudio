PAYMENT_SERVICE_PORT=6007
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
NODE_ENV=development

# Razorpay
# Key id/secret sign the checkout callback and authorise refunds. Without them
# the service still boots, but online payment routes return 503.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Separate secret configured on the Razorpay webhook itself — NOT the key
# secret. Webhook delivery fails closed (500) if this is unset.
RAZORPAY_WEBHOOK_SECRET=

# Postgres (orders, payments, audit log)
POSTGRES_URL=

# Redis (webhook event deduplication, auth cache)
REDIS_DATABASE_URL=redis://localhost:6379

# JWT (verified by @repo/middlewares' isAuthenticated)
ACCESS_TOKEN_JWT_SECRET_KEY=
