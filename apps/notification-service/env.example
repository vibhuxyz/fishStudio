# ── Notification Service ──

# Server
NOTIFICATION_SERVICE_PORT=6005

# CORS (comma-separated origins, defaults to localhost:3000-3003)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Environment (controls SMS gating, morgan format)
NODE_ENV=development

# RabbitMQ (consumed via @repo/libs/rabbitmq)
RABBITMQ_URL=amqp://localhost:5672

# PostgreSQL (notifications stored here, via @repo/db-postgres)
POSTGRES_URL=postgresql://user:pass@localhost:5432/fishstudio

# MongoDB (user contact lookup, via @repo/db-mongo)
MONGO_URL=mongodb://localhost:27017/fishstudio

# Redis (OTP status tracking, via @repo/libs/redis)
REDIS_URL=redis://localhost:6379

# SMTP (email dispatch, via @repo/libs/sendMail)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
