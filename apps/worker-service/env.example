WORKER_SERVICE_PORT=6006
NODE_ENV=development

# JWT (verifies the token on every WebSocket upgrade)
ACCESS_TOKEN_JWT_SECRET_KEY=

# RabbitMQ (OTP, order, and admin event queues)
RABBITMQ_PROTOCOL=amqp
RABBITMQ_HOST_NAME=localhost
RABBITMQ_USER_NAME=
RABBITMQ_PASSWORD=
RABBITMQ_PORT=5672

# Databases (read by @repo/jobs cron jobs: cleanup, abandoned-cart, stale-orders)
POSTGRES_URL=
MONGO_URL=

# SMTP / email OTP (via @repo/libs/sendMail)
SMTP_HOST=
SMTP_PORT=
SMTP_SERVICE=
SMTP_USER=
SMTP_PASS=
BREVO_API_KEY=

# SMS OTP (via @repo/libs/sendOtp)
FAST2SMS_API_KEY=
